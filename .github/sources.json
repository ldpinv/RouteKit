  "replacements": [
    {
      "category": "ai",
      "rule": "regexp,^chatgpt-async-webps-prod-\\S+-\\d+\\.webpubsub\\.azure\\.com$",
      "replace_with": [
        "DOMAIN-WILDCARD,chatgpt-async-webps-prod-*-*.webpubsub.azure.com"
      ],
      "reason": "Bounded tenant hostname wildcard for both clients; slightly broader than the numeric regex, never all Azure."
    },
    {
      "category": "ai",
      "rule": "DOMAIN-KEYWORD,alkalimakersuite-pa.clients6.google.com",
      "replace_with": [
        "DOMAIN,alkalimakersuite-pa.clients6.google.com"
      ],
      "reason": "Use the complete API hostname instead of a substring."
    },
    {
      "category": "ai",
      "rule": "DOMAIN-KEYWORD,chatgpt-async-webps-prod",
      "replace_with": [
        "DOMAIN-WILDCARD,chatgpt-async-webps-prod-*-*.webpubsub.azure.com"
      ],
      "reason": "Constrain the dynamic OpenAI tenant to its actual Azure domain."
    },
    {
      "category": "streaming",
      "rule": "regexp,(^|\\.)apiproxy-device-prod-nlb-.+\\.amazonaws\\.com$",
      "replace_with": [
        "DOMAIN-WILDCARD,apiproxy-device-prod-nlb-*.amazonaws.com",
        "DOMAIN-WILDCARD,*.apiproxy-device-prod-nlb-*.amazonaws.com"
      ],
      "reason": "Bounded Netflix AWS hostname patterns; preserves the original root/subdomain alternatives."
    },
    {
      "category": "streaming",
      "rule": "regexp,(^|\\.)apiproxy-website-nlb-prod-.+\\.amazonaws\\.com$",
