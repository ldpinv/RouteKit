      "rule": "DOMAIN,browser-intake-datadoghq.com",
      "reason": "Shared authentication/telemetry infrastructure. Preserve service-specific tenant hostnames instead of routing every customer through AI."
    },
    {
      "category": "ai",
      "rule": "DOMAIN-KEYWORD,datadog",
