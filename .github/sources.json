        "DOMAIN,hses.akamaized.net",
        "DOMAIN,hses1.akamaized.net",
        "DOMAIN,hses2.akamaized.net",
        "DOMAIN,hses3.akamaized.net",
        "DOMAIN,hses4.akamaized.net",
        "DOMAIN,hses5.akamaized.net",
        "DOMAIN,hses6.akamaized.net",
        "DOMAIN,hses7.akamaized.net"
